{
  "name": "open-dxp/payment-provider-unzer-bundle",
  "license": "GPL-3.0+",
  "type": "opendxp-bundle",
  "description": "OpenDXP Payment Provider - Unzer (Heidelpay)",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "symfony/runtime": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "unzerdev/php-sdk": "^3.0 || ^1.2.0",
    "open-dxp/opendxp": "^1.0",
    "open-dxp/ecommerce-framework-bundle": "^1.0"
  },
  "require-dev": {
    "open-dxp/test-foundation": "1.x-dev",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "symfony/dotenv": "^7.4",
    "symfony/runtime": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "opendxp": {
      "bundles": [
        "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\OpenDxpPaymentProviderUnzerBundle"
      ]
    }
  }
}
